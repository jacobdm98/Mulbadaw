---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { createImageUrlBuilder } from '@sanity/image-url';
import { PortableText } from 'astro-portabletext';
import PortableMediaBlock from './PortableMediaBlock.astro';

interface Props {
  lang: 'en' | 'sw';
  page: 'about' | 'contact' | 'history';
}

const { lang, page } = Astro.props;
const schemaType = `${page}Page`;
const documentId = schemaType;
const pageData = await sanityClient.fetch(
  `*[_type == $schemaType && _id == $documentId][0]`,
  { schemaType, documentId },
);
const localized = (field: any) => field?.[lang] || field?.en || '';
const title = localized(pageData?.title);
const content = pageData?.content?.[lang] || pageData?.content?.en || [];
const builder = createImageUrlBuilder({ projectId: 'tyk7mbom', dataset: 'production' });
const mediaComponents = {
  type: {
    imageBlock: PortableMediaBlock,
    imageGalleryBlock: PortableMediaBlock,
    videoBlock: PortableMediaBlock,
  },
};
const official = pageData?.details;
const employees = pageData?.employees || [];
---

<Layout title={title} lang={lang}>
  <article class="max-w-6xl mx-auto px-4 py-12">
    {title && <h1 class="text-4xl font-bold mb-8">{title}</h1>}

    {page === 'contact' ? (
      <>
        {localized(pageData?.intro) && <p class="max-w-3xl text-lg text-gray-600 mb-10">{localized(pageData.intro)}</p>}

        {official && (
          <section class="mb-12 rounded-2xl bg-emerald-800 p-8 text-white shadow-lg">
            {localized(official.label) && <p class="mb-2 text-sm font-semibold uppercase tracking-[0.2em] text-emerald-200">{localized(official.label)}</p>}
            <h2 class="text-3xl font-bold">{localized(pageData.title)}</h2>
            <div class="mt-6 grid gap-3 text-emerald-50 sm:grid-cols-3">
              {localized(official.email) && <a class="break-words hover:text-white hover:underline" href={`mailto:${localized(official.email)}`}>{localized(official.email)}</a>}
              {localized(official.phone) && <a class="hover:text-white hover:underline" href={`tel:${localized(official.phone)}`}>{localized(official.phone)}</a>}
              {localized(official.address) && <span>{localized(official.address)}</span>}
            </div>
          </section>
        )}

        {employees.length > 0 && (
          <section>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {employees.map((employee: any) => {
                const name = localized(employee.name);
                const role = localized(employee.role);
                const email = localized(employee.email);
                const phone = localized(employee.phone);
                const address = localized(employee.address);
                const photo = employee.photo ? builder.image(employee.photo).width(600).height(600).fit('crop').url() : '';
                return (
                  <article class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
                    {photo ? <img src={photo} alt={name} class="h-64 w-full object-cover" /> : <div class="h-64 bg-emerald-100" />}
                    <div class="p-6">
                      {name && <h3 class="text-xl font-bold text-gray-900">{name}</h3>}
                      {role && <p class="mt-1 text-emerald-700">{role}</p>}
                      <div class="mt-5 space-y-2 text-sm text-gray-600">
                        {email && <a class="block break-words hover:text-emerald-700 hover:underline" href={`mailto:${email}`}>{email}</a>}
                        {phone && <a class="block hover:text-emerald-700 hover:underline" href={`tel:${phone}`}>{phone}</a>}
                        {address && <p>{address}</p>}
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        )}
      </>
    ) : (
      <div class="prose prose-lg max-w-none">
        {content.length > 0 && <PortableText value={content} components={mediaComponents} />}
      </div>
    )}
  </article>
</Layout>
