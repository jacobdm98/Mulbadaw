---
import Layout from '../layouts/Layout.astro';

interface Props {
  lang: 'en' | 'sw';
}

const { lang } = Astro.props;
const labels = {
  en: {
    heading: 'Our Photo Gallery',
    empty: 'No media added yet.',
    loading: 'Loading gallery…',
    error: 'The gallery could not be loaded. Please try again later.',
    video: 'Video',
    alt: 'Gallery photo',
  },
  sw: {
    heading: 'Maktaba Yetu ya Picha',
    empty: 'Bado hakuna picha au video zilizowekwa.',
    loading: 'Inapakia picha…',
    error: 'Picha hazikuweza kupakiwa. Tafadhali jaribu tena baadaye.',
    video: 'Video',
    alt: 'Picha ya maktaba',
  },
};
const text = labels[lang];
---

<Layout title={text.heading} lang={lang}>
  <main class="max-w-6xl mx-auto px-4 py-12" data-gallery-page data-lang={lang}>
    <h1 class="text-4xl font-bold mb-8">{text.heading}</h1>
    <p id="gallery-status" class="text-gray-500" role="status" aria-live="polite">{text.loading}</p>
    <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6"></div>

    <div id="lightbox" class="fixed inset-0 bg-black/95 z-50 hidden flex-col items-center justify-between p-4 md:p-8">
      <div class="w-full flex justify-end"><button id="lightbox-close" type="button" class="text-white text-3xl font-bold p-2">&times;</button></div>
      <div class="relative flex items-center justify-center max-w-5xl w-full flex-grow">
        <button id="lightbox-prev" type="button" class="absolute left-0 bg-white/20 text-white p-3 rounded-full text-xl z-10">&#10094;</button>
        <div class="flex flex-col items-center max-h-[70vh] w-full justify-center">
          <div id="lightbox-media-container" class="flex items-center justify-center max-h-[60vh] w-full"></div>
          <p id="lightbox-caption" class="text-white mt-4 text-center text-lg"></p>
        </div>
        <button id="lightbox-next" type="button" class="absolute right-0 bg-white/20 text-white p-3 rounded-full text-xl z-10">&#10095;</button>
      </div>
      <div class="w-full overflow-x-auto py-2"><div id="lightbox-strip" class="flex items-center justify-center gap-3 min-w-max px-4"></div></div>
    </div>
  </main>
</Layout>

<script>
  import { createClient } from '@sanity/client';

  type GalleryItem = {
    _type: 'imageItem' | 'videoItem';
    image?: { asset?: { _ref?: string } };
    videoFile?: { asset?: { _ref?: string } };
    caption?: Partial<Record<'en' | 'sw', string>>;
    alt?: string;
  };

  type GalleryDocument = {
    photos?: GalleryItem[];
  } | null;

  const labels = {
    en: {
      empty: 'No media added yet.',
      error: 'The gallery could not be loaded. Please try again later.',
      video: 'Video',
      alt: 'Gallery photo',
    },
    sw: {
      empty: 'Bado hakuna picha au video zilizowekwa.',
      error: 'Picha hazikuweza kupakiwa. Tafadhali jaribu tena baadaye.',
      video: 'Video',
      alt: 'Picha ya maktaba',
    },
  };

  const page = document.querySelector<HTMLElement>('[data-gallery-page]');
  const lang = page?.dataset.lang === 'sw' ? 'sw' : 'en';
  const text = labels[lang];
  const status = document.getElementById('gallery-status');
  const grid = document.getElementById('gallery-grid');
  const lightbox = document.getElementById('lightbox');
  const mediaContainer = document.getElementById('lightbox-media-container');
  const lightboxCaption = document.getElementById('lightbox-caption');
  const lightboxStrip = document.getElementById('lightbox-strip');

  if (status && grid && lightbox && mediaContainer && lightboxCaption && lightboxStrip) {
    const sanityClient = createClient({
      projectId: 'tyk7mbom',
      dataset: 'production',
      apiVersion: '2024-01-01',
      useCdn: false,
    });

    const query = '*[_type == "gallery" && _id == "gallery"][0]{ photos[] }';
    let photos: GalleryItem[] = [];
    let currentIndex = 0;

    function fileUrl(ref: string): string {
      const [, id, extension] = ref.split('-');
      return `https://cdn.sanity.io/files/tyk7mbom/production/${id}.${extension}`;
    }

    function imageUrl(image: GalleryItem['image'], width: number, height: number): string {
      const ref = image?.asset?._ref;
      if (!ref) return '';
      const [, id, dimensions, format] = ref.split('-');
      return `https://cdn.sanity.io/images/tyk7mbom/production/${id}-${dimensions}.${format}?w=${width}&h=${height}&fit=crop`;
    }

    function caption(item: GalleryItem): string {
      return item.caption?.[lang] || item.caption?.en || '';
    }

    function updateLightbox(): void {
      const item = photos[currentIndex];
      if (!item) return;

      lightboxCaption.textContent = caption(item);
      mediaContainer.replaceChildren();

      const videoRef = item.videoFile?.asset?._ref;
      if (item._type === 'videoItem' && videoRef) {
        const video = document.createElement('video');
        video.src = fileUrl(videoRef);
        video.controls = true;
        video.autoplay = true;
        video.className = 'max-h-[60vh] max-w-full rounded object-contain';
        mediaContainer.appendChild(video);
      } else if (item.image) {
        const img = document.createElement('img');
        img.src = imageUrl(item.image, 1200, 800);
        img.alt = item.alt || text.alt;
        img.className = 'max-h-[60vh] max-w-full rounded object-contain';
        mediaContainer.appendChild(img);
      }

      lightboxStrip.replaceChildren();
      photos.forEach((photo, index) => {
        const thumb = document.createElement('button');
        thumb.type = 'button';
        thumb.className = `cursor-pointer overflow-hidden border-2 ${index === currentIndex ? 'border-white' : 'border-transparent opacity-50'}`;
        thumb.setAttribute('aria-label', `${text.alt} ${index + 1}`);
        thumb.onclick = () => {
          currentIndex = index;
          updateLightbox();
        };

        const thumbUrl = imageUrl(photo.image, 100, 80);
        if (thumbUrl) {
          const img = document.createElement('img');
          img.src = thumbUrl;
          img.alt = '';
          img.className = 'w-16 h-12 object-cover';
          thumb.appendChild(img);
        } else {
          thumb.textContent = '▶';
          thumb.className += ' w-16 h-12 bg-black text-white';
        }
        lightboxStrip.appendChild(thumb);
      });
    }

    function openLightbox(index: number): void {
      currentIndex = index;
      updateLightbox();
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
    }

    function renderGallery(items: GalleryItem[]): void {
      photos = items;
      grid.replaceChildren();
      status.hidden = true;

      if (photos.length === 0) {
        status.textContent = text.empty;
        status.hidden = false;
        return;
      }

      photos.forEach((item, index) => {
        const card = document.createElement('button');
        card.type = 'button';
        card.className = 'gallery-thumb text-left cursor-pointer bg-white border rounded-lg shadow-sm overflow-hidden flex flex-col transition hover:scale-[1.02]';
        card.onclick = () => openLightbox(index);

        const videoRef = item.videoFile?.asset?._ref;
        if (item._type === 'videoItem' && videoRef) {
          const preview = document.createElement('div');
          preview.className = 'relative w-full h-60 bg-black flex items-center justify-center';
          const video = document.createElement('video');
          video.src = fileUrl(videoRef);
          video.className = 'w-full h-60 object-cover pointer-events-none';
          video.muted = true;
          video.preload = 'metadata';
          preview.appendChild(video);

          const badge = document.createElement('span');
          badge.className = 'absolute bg-black/60 text-white p-2 rounded-full text-sm';
          badge.textContent = `▶ ${text.video}`;
          preview.appendChild(badge);
          card.appendChild(preview);
        } else {
          const url = imageUrl(item.image, 600, 400);
          if (url) {
            const img = document.createElement('img');
            img.src = url;
            img.alt = item.alt || text.alt;
            img.className = 'w-full h-60 object-cover pointer-events-none';
            img.loading = 'lazy';
            card.appendChild(img);
          }
        }

        const itemCaption = caption(item);
        if (itemCaption) {
          const paragraph = document.createElement('p');
          paragraph.className = 'p-4 text-gray-600 text-sm pointer-events-none';
          paragraph.textContent = itemCaption;
          card.appendChild(paragraph);
        }
        grid.appendChild(card);
      });
    }

    document.getElementById('lightbox-prev')?.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + photos.length) % photos.length;
      updateLightbox();
    });
    document.getElementById('lightbox-next')?.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % photos.length;
      updateLightbox();
    });
    document.getElementById('lightbox-close')?.addEventListener('click', () => {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
    });
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
      }
    });

    sanityClient.fetch<GalleryDocument>(query).then(
      (gallery) => renderGallery(gallery?.photos || []),
      (error: unknown) => {
        console.error('Failed to load the Sanity gallery.', error);
        status.textContent = text.error;
        status.setAttribute('role', 'alert');
      },
    );
  }
</script>
