---
// src/pages/en/news/[slug].astro
import Layout from '../../../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { createImageUrlBuilder } from '@sanity/image-url';
import { PortableText } from 'astro-portabletext';

// 1. Tell Astro which static pages to generate based on Sanity slugs
export async function getStaticPaths() {
  const articles = await sanityClient.fetch(`*[_type == "article" && defined(slug.current)]{ "slug": slug.current }`);
  
  return articles.map((article: any) => ({
    params: { slug: article.slug },
  }));
}

const builder = createImageUrlBuilder({
  projectId: 'tyk7mbom',
  dataset: 'production',
});

const { slug } = Astro.params;
const currentLang = 'sw';

const query = `*[_type == "article" && slug.current == $slug][0]{
  title,
  publishedAt,
  mainImage,
  body
}`;

const article = await sanityClient.fetch(query, { slug });
if (!article) return Astro.redirect('/404');

const currentTitle = article.title?.[currentLang] || article.title?.en || 'Untitled';
const currentBody = article.body?.[currentLang] || article.body?.en || [];
---

<Layout title={currentTitle} lang={currentLang}>
  <main class="max-w-3xl mx-auto px-4 py-12">
    <a href={`/${currentLang}/news`} class="text-blue-600 hover:underline text-sm mb-6 inline-block">&larr; Back to News</a>
    
    <h1 class="text-4xl font-bold mb-4">{currentTitle}</h1>
    
    {article.mainImage && (
      <img src={builder.image(article.mainImage).width(1200).height(600).fit('crop').url()} alt="" class="w-full h-80 object-cover rounded-lg mb-8 shadow-sm" />
    )}

    <div class="prose max-w-none space-y-6">
      <PortableText 
        value={currentBody} 
        components={{
          type: {
            imageBlock: ({ node }: { node: any }) => {
              if (!node.image) return null; // Safely skip if no image was uploaded
              const captionText = node.caption?.[currentLang] || node.caption?.en || '';
              return (
                <figure class="my-6">
                  <img src={builder.image(node.image).width(800).fit('max').url()} alt="" class="w-full rounded-lg shadow-sm" />
                  {captionText && <figcaption class="text-center text-sm text-gray-500 mt-2">{captionText}</figcaption>}
                </figure>
              );
            }
          }
        }}
      />
    </div>
  </main>
</Layout>