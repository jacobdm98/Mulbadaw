---
import Layout from '../../layouts/Layout.astro';
import JamboMaisha from '../../data/translations/JamboMaisha.json';

const jamboMaisha = JamboMaisha.sw;
const title = "JamboMaisha";
const lang = "sw";
---

<Layout title={title} lang={lang}>
  <main class="max-w-4xl mx-auto px-6 py-12 font-sans text-slate-800 space-y-16">
    
    <!-- Hero Section -->
    <header class="text-center pt-8 pb-4">
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-emerald-700 mb-4">
        {jamboMaisha.name}
      </h1>
      <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
        {jamboMaisha.tagline}
      </p>
    </header>

    <!-- About Section -->
    <section class="bg-emerald-50/50 rounded-2xl p-8 border border-emerald-100 shadow-sm">
      <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2">
        <span class="w-2 h-6 bg-emerald-600 rounded-full inline-block"></span>
        {jamboMaisha.about.title}
      </h2>
      <div class="space-y-4 text-slate-700 leading-relaxed text-base">
        {jamboMaisha.about.description.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>

    <!-- Problems Section -->
    <section>
      <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2">
        <span class="w-2 h-6 bg-amber-500 rounded-full inline-block"></span>
        {jamboMaisha.problems.title}
      </h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {jamboMaisha.problems.items.map((problem) => (
          <article class="bg-white p-6 rounded-xl border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
            <h3 class="text-lg font-semibold text-slate-900 mb-2">{problem.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{problem.description}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Solutions Section -->
    <section>
      <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2">
        <span class="w-2 h-6 bg-blue-600 rounded-full inline-block"></span>
        {jamboMaisha.solutions.title}
      </h2>
      <div class="grid gap-6 sm:grid-cols-3">
        {jamboMaisha.solutions.items.map((solution) => (
          <article class="bg-white p-6 rounded-xl border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
            <h3 class="text-lg font-semibold text-slate-900 mb-2">{solution.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{solution.description}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Services / Solutions Badges -->
    <section class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
      <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2">
        <span class="w-2 h-6 bg-purple-600 rounded-full inline-block"></span>
        {jamboMaisha.services.title}
      </h2>
      <div class="flex flex-wrap gap-2.5">
        {jamboMaisha.services.items.map((service) => (
          <span class="bg-white px-4 py-2 rounded-lg text-sm font-medium text-slate-700 border border-slate-200/80 shadow-xs">
            {service}
          </span>
        ))}
      </div>
    </section>

    <!-- Getting Started Section -->
    <section>
      <h2 class="text-2xl font-bold text-slate-900 mb-2 flex items-center gap-2">
        <span class="w-2 h-6 bg-emerald-600 rounded-full inline-block"></span>
        {jamboMaisha.gettingStarted.title}
      </h2>
      <p class="text-slate-600 mb-8 italic">{jamboMaisha.gettingStarted.introduction}</p>
      
      <div class="space-y-6">
        {jamboMaisha.gettingStarted.steps.map((stepItem) => (
          <div class="flex gap-4 items-start bg-white p-6 rounded-xl border border-slate-200/80 shadow-xs">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-emerald-100 text-emerald-800 font-bold flex items-center justify-center text-sm">
              {stepItem.step}
            </span>
            <div class="space-y-1 flex-grow">
              <h3 class="text-lg font-semibold text-slate-900">{stepItem.title}</h3>
              <p class="text-slate-600 text-sm">{stepItem.description}</p>
              {stepItem.shortcode && (
                <div class="mt-3 inline-block bg-slate-900 text-emerald-400 font-mono text-sm px-3 py-1.5 rounded-md tracking-wider">
                  {stepItem.shortcode}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Onsite Training Section -->
    <section class="bg-amber-50/50 rounded-2xl p-8 border border-amber-100 shadow-sm">
      <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2">
        <span class="w-2 h-6 bg-amber-500 rounded-full inline-block"></span>
        {jamboMaisha.onsiteTraining.title}
      </h2>
      <div class="space-y-4 text-slate-700 leading-relaxed text-base">
        {jamboMaisha.onsiteTraining.description.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>

    <!-- Contact Section -->
    <section class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm text-center md:text-left flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="space-y-2 max-w-lg">
        <h2 class="text-2xl font-bold text-slate-900">{jamboMaisha.contact.title}</h2>
        <p class="text-slate-600 text-sm leading-relaxed">{jamboMaisha.contact.description}</p>
      </div>
      <div class="bg-slate-50 p-6 rounded-xl border border-slate-200/80 w-full md:w-auto text-left space-y-2 text-sm text-slate-700 shrink-0">
        <p class="font-bold text-slate-900 text-base">{jamboMaisha.contact.person}</p>
        <p class="text-slate-500">{jamboMaisha.contact.organization}</p>
        <p>📞 <a href={`tel:${jamboMaisha.contact.phone}`} class="text-emerald-700 hover:underline">{jamboMaisha.contact.phone}</a></p>
        <p>✉️ <a href={`mailto:${jamboMaisha.contact.email}`} class="text-emerald-700 hover:underline">{jamboMaisha.contact.email}</a></p>
        <p>🌐 <a href={jamboMaisha.contact.website} target="_blank" rel="noopener noreferrer" class="text-emerald-700 hover:underline">{jamboMaisha.contact.website}</a></p>
      </div>
    </section>

  </main>
</Layout>