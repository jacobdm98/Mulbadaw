---
import '../styles/global.css';
import StudioPreview from '../components/StudioPreview';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Content preview</title>
  </head>
  <body class="flex min-h-screen flex-col bg-gray-50 text-gray-900">
    <nav class="bg-white p-4 shadow-sm">
      <div class="mx-auto flex max-w-6xl items-center justify-between">
        <a href="/en/" class="text-xl font-bold text-yellow-700">HLH Mulbadaw LTD</a>
        <a href="/admin" class="font-medium hover:text-yellow-700">Back to Studio</a>
      </div>
    </nav>
    <main class="mx-auto w-full max-w-6xl flex-grow p-6">
      <StudioPreview client:only="react" />
    </main>
    <footer class="mt-12 border-t p-6 text-center text-gray-500">
      &copy; {new Date().getFullYear()} HLH Mulbadaw LTD
    </footer>
  </body>
</html>
